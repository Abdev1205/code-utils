# Copy to .env.local and fill in. Everything here is optional.
#
# Documents may reference values as {{env:NAME|fallback}}. With the variable set
# you read your own value; without it you read the fallback. Nothing on disk changes.

# Collections that live in other repos on your machine (runbooks, RCAs, reports).
# Unset, those collections are simply absent.
# UNDERSTAND_EXTRA_ROOT=/absolute/path/to/your/other/repos

# Where Claude Code keeps session transcripts, if not the default.
# CLAUDE_PROJECTS_DIR=~/.claude/projects

# Model used by "Teach me this" and `npm run lessons`.
# UNDERSTAND_LESSON_MODEL=sonnet

# ---- placeholders used by the shipped tracks ----
# voice-platform: the organisation the learner works at
# ORG_NAME=
# voice-platform: the customer whose VPC hosts the telephony servers
# TELEPHONY_CUSTOMER=
# kubernetes-basics: the cluster the lessons refer to
# KUBE_CLUSTER_NAME=
# KUBE_NAMESPACE=
# POD_NAME=
